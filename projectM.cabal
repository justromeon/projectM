cabal-version:   3.0
name:            projectM
version:         0.1.0.0
license:         NONE
author:          Justin Kian Romeon
maintainer:      romeonjustin@gmail.com
build-type:      Simple

common warnings
    ghc-options: -Wall

executable projectM
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base,
        projectM
    hs-source-dirs:   app
    default-language: Haskell2010

library
    import:           warnings
    exposed-modules:
        Project,
        Demo
    build-depends:
        base,
        text
    hs-source-dirs:   src
    default-language: Haskell2010

test-suite projectM-test
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base,
        projectM
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    default-language: Haskell2010
